index 67c046e5..8aefb48c 100644
--- a/schemes.tex
+++ b/schemes.tex
@@ -3878,7 +3878,29 @@ over a base which is preserved under arbitrary base change.
 \end{lemma}
 
 \begin{proof}
-Omitted.
+Let $f : X \to Y$ be a quasi-compact morphism of schemes over $S$,
+and let $S' \to S$ be a morphism of schemes. Set
+$Y' = Y \times_S S'$ and $X' = X \times_S S'$.
+The canonical identification $X' = X \times_Y Y'$ identifies
+$f' : X' \to Y'$ with the base change of $f$ by the projection
+$q : Y' \to Y$.
+
+Choose an affine open covering $Y = \bigcup_{i \in I} U_i$.
+For each $i$, write $f^{-1}(U_i) = \bigcup_{j = 1}^{n_i} V_{ij}$
+as a finite union of affine opens, using
+Lemma \ref{lemma-quasi-compact-affine}.
+Choose an affine open covering
+$q^{-1}(U_i) = \bigcup_{k \in K_i} W_{ik}$.
+For each $i$ and $k$ we have
+$$
+(f')^{-1}(W_{ik}) =
+\bigcup\nolimits_{j = 1}^{n_i} V_{ij} \times_{U_i} W_{ik}.
+$$
+By Lemma \ref{lemma-affine-covering-fibre-product}
+the right hand side is a finite affine open covering.
+Thus $(f')^{-1}(W_{ik})$ is quasi-compact.
+The $W_{ik}$ form an affine open covering of $Y'$, so
+Lemma \ref{lemma-quasi-compact-affine} shows that $f'$ is quasi-compact.
 \end{proof}
 
 \begin{lemma}
